<!-- Add hauling job to hay golem -->
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="DV_Golem_Hay"]/comps/li[@Class="Asimov.CompProperties_Automaton"]/enabledWorkTypes</xpath>
		<value>
      		<li>Hauling</li>
		</value>
	</Operation>

<!-- Replace mining job for animals handling to clay golem -->
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DV_Golem_Clay"]/comps/li[@Class="Asimov.CompProperties_Automaton"]/enabledWorkTypes</xpath>
		<value>
      		<enabledWorkTypes>
			    <li>Firefighter</li>
			    <li>BasicWorker</li>
				<li>PlantCutting</li>
				<li>Handling</li>
				<li>Hauling</li>
				<li>Cleaning</li>
			</enabledWorkTypes>
		</value>
	</Operation>

</Patch>
