                </filter>
                <count>30</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>DV_Clay</li>
                    </thingDefs>
                </filter>
                <count>60</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
